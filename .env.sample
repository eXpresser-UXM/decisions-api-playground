# このファイルを .env にコピーして使います。
#   cp .env.sample .env
# APIキーを書くと、設定画面の初期値として使われます（画面で入力したキーがあればそちらを優先）。
# キーの値はブラウザには送られません（サーバー側でのみ使います）。
# .env は .gitignore で除外されています。キーを書いたファイルをコミットしないでください。
# デモ専用のキーを作り、利用額の上限を設定し、使用後は無効化することを推奨します。
# .env を書き換えたら、npm run dev を止めて起動し直してください。
# Vercel で公開する場合は、ここではなく Vercel の環境変数に登録します。登録したキーは誰でも使える状態になるので、
# ハンズオンの間だけ登録し、終わったらキーを無効化・削除して再デプロイしてください（README の「Vercel で公開する場合」）。

# ---- OpenAI（Decisions API）----
# APIキーの取得先：https://platform.openai.com/api-keys
OPENAI_API_KEY=
# エンドポイント。下は OpenAI の既定値です。別のサーバー（互換 API など）に向けるときだけ書き換えてください。
# 機密ではないので設定画面に表示されますが、画面からは変更できません（キーを別のサーバーへ送らせないため）。
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- TypeSafe（Jev）----
# APIキーの取得先：https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# エンドポイント。下は TypeSafe の既定値です。別のサーバーに向けるときだけ書き換えてください。
TYPESAFE_BASE_URL=https://api.typesafe.ai
